# cp .env.example .env  — never commit .env
# Groq API key: https://console.groq.com/keys
# When set, config.py routes all OpenAI-compatible clients (generation, RAGAS,
# judge, NeMo) to Groq.
GROQ_API_KEY=
# Optional: route only the RAGAS evaluator (src/m4_eval.py) to OpenRouter.
# Groq free tier allows 200K tokens/day per model, not enough for RAGAS on 50 questions.
OPENROUTER_API_KEY=
# Optional overrides (generation/judge default: openai/gpt-oss-20b; evaluator: qwen/qwen3.8-27b)
# GENERATION_MODEL=openai/gpt-oss-20b
# JUDGE_MODEL=openai/gpt-oss-20b
# RAGAS_EVALUATOR_MODEL=openai/gpt-oss-20b
# RAGAS_MAX_WORKERS=1
# Keep false: M5 then uses its local fallback instead of 1 API call/chunk.
GROQ_ENRICHMENT_ENABLED=false

# Alternative: OpenAI directly (leave GROQ_API_KEY empty)
OPENAI_API_KEY=

# Optional: HuggingFace token (only if using HF Inference Endpoints)
HF_TOKEN=
